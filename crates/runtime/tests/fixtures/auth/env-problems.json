{
  "about": "authEnvProblems cases both verifiers answer alike (the native Firebase provider needs only FIREBASE_PROJECT_ID, so a missing project is not shared).",
  "cases": [
    {
      "name": "oidc complete",
      "env": {
        "AUTH_PROVIDER": "oidc",
        "OIDC_ISSUER_URL": "https://i",
        "OIDC_AUDIENCE": "a"
      },
      "expect": []
    },
    {
      "name": "oidc without issuer",
      "env": {
        "AUTH_PROVIDER": "oidc",
        "OIDC_AUDIENCE": "a"
      },
      "expect": [
        "AUTH_PROVIDER=oidc needs OIDC_ISSUER_URL"
      ]
    },
    {
      "name": "oidc without issuer or audience",
      "env": {
        "AUTH_PROVIDER": "oidc"
      },
      "expect": [
        "AUTH_PROVIDER=oidc needs OIDC_ISSUER_URL",
        "AUTH_PROVIDER=oidc needs OIDC_AUDIENCE"
      ]
    },
    {
      "name": "the auth emulator is set",
      "env": {
        "AUTH_PROVIDER": "oidc",
        "OIDC_ISSUER_URL": "https://i",
        "OIDC_AUDIENCE": "a",
        "FIREBASE_AUTH_EMULATOR_HOST": "localhost:9099"
      },
      "expect": [
        "FIREBASE_AUTH_EMULATOR_HOST is set: the Auth emulator is for local dev only"
      ]
    },
    {
      "name": "a demo project",
      "env": {
        "FIREBASE_PROJECT_ID": "demo-app",
        "FIREBASE_CLIENT_EMAIL": "x",
        "FIREBASE_PRIVATE_KEY": "y"
      },
      "expect": [
        "FIREBASE_PROJECT_ID=demo-app is an emulator-only demo project"
      ]
    },
    {
      "name": "an unknown provider",
      "env": {
        "AUTH_PROVIDER": "saml"
      },
      "expect": [
        "AUTH_PROVIDER must be one of firebase, oidc, got 'saml'"
      ]
    },
    {
      "name": "a real firebase project",
      "env": {
        "FIREBASE_PROJECT_ID": "prod-app",
        "FIREBASE_CLIENT_EMAIL": "x",
        "FIREBASE_PRIVATE_KEY": "y"
      },
      "expect": []
    }
  ]
}
