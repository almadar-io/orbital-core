{
  "about": "Twin host fixture: os asks in order against ONE fresh host, with the answers both the Node answerer and the Rust os_host must give. ${name} in a string is replaced by the variable of that name (tmp, port, closedPort, and every bind); {\"$var\":\"name\"} in an argument is the variable's value as is; {\"$number\":true} in an expected answer matches any number; an expected error carries kind and either message or messagePrefix; bind maps a variable name to a top-level field of the ok answer. A step with a key is asked with a call site whose success route is DONE and failure route FAILED; a deferred step expects the answer to be deferred and then the completion {event, payload} for its key (deferred \"pending\" does not wait for it); a cancel step cancels the pending completion of its key and expects cancelled true or false.",
  "grants": {
    "fs": [{ "glob": "${tmp}/**", "modes": ["read", "write", "create", "remove", "meta"] }],
    "exec": ["echo", "sleep", "nope-not-a-command"],
    "net": [
      { "target": "127.0.0.1:${port}", "kinds": ["tcp"] },
      { "target": "127.0.0.1:${closedPort}", "kinds": ["tcp"] },
      { "target": "localhost:${port}", "kinds": ["tcp"] },
      { "target": "127.0.0.1:0", "kinds": ["tcp"] }
    ],
    "env": ["FOO"]
  },
  "steps": [
    { "name": "write a file", "op": "os/write-file", "args": ["${tmp}/a.txt", "aGVsbG8="], "expect": { "ok": { "bytes": 5 } } },
    { "name": "read it back", "op": "os/read-file", "args": ["${tmp}/a.txt"], "expect": { "ok": { "data": "aGVsbG8=" } } },
    { "name": "append", "op": "os/append-file", "args": ["${tmp}/a.txt", "IHdvcmxk"], "expect": { "ok": { "bytes": 6 } } },
    { "name": "read the whole", "op": "os/read-file", "args": ["${tmp}/a.txt"], "expect": { "ok": { "data": "aGVsbG8gd29ybGQ=" } } },
    { "name": "chmod", "op": "os/chmod", "args": ["${tmp}/a.txt", 416], "expect": { "ok": {} } },
    {
      "name": "stat",
      "op": "os/stat",
      "args": ["${tmp}/a.txt"],
      "expect": { "ok": { "kind": "file", "size": 11, "mode": 416, "uid": { "$number": true }, "gid": { "$number": true }, "atime": { "$number": true }, "mtime": { "$number": true }, "ctime": { "$number": true } } }
    },
    { "name": "mkdir recursive", "op": "os/mkdir", "args": ["${tmp}/d/e", true], "expect": { "ok": {} } },
    { "name": "file in the directory", "op": "os/write-file", "args": ["${tmp}/d/b.txt", "Yg=="], "expect": { "ok": { "bytes": 1 } } },
    { "name": "symlink", "op": "os/symlink", "args": ["b.txt", "${tmp}/d/link"], "expect": { "ok": {} } },
    { "name": "readlink", "op": "os/readlink", "args": ["${tmp}/d/link"], "expect": { "ok": { "target": "b.txt" } } },
    {
      "name": "list-dir is sorted with kinds",
      "op": "os/list-dir",
      "args": ["${tmp}/d"],
      "expect": { "ok": { "entries": [{ "name": "b.txt", "kind": "file" }, { "name": "e", "kind": "dir" }, { "name": "link", "kind": "symlink" }] } }
    },
    { "name": "exists", "op": "os/exists", "args": ["${tmp}/a.txt"], "expect": { "ok": { "ok": true } } },
    { "name": "does not exist", "op": "os/exists", "args": ["${tmp}/none"], "expect": { "ok": { "ok": false } } },
    { "name": "open for read", "op": "os/open", "args": ["${tmp}/a.txt", "r"], "expect": { "ok": { "fd": 3 } } },
    { "name": "read five", "op": "os/read", "args": [3, 5], "expect": { "ok": { "data": "aGVsbG8=", "eof": false } } },
    { "name": "seek to the end", "op": "os/seek", "args": [3, 0, "end"], "expect": { "ok": { "offset": 11 } } },
    { "name": "read at the end is eof", "op": "os/read", "args": [3, 4], "expect": { "ok": { "data": "", "eof": true } } },
    { "name": "seek from the start", "op": "os/seek", "args": [3, 6, "set"], "expect": { "ok": { "offset": 6 } } },
    { "name": "read the rest", "op": "os/read", "args": [3, 100], "expect": { "ok": { "data": "d29ybGQ=", "eof": false } } },
    { "name": "write on a read-only fd", "op": "os/write", "args": [3, "eA=="], "expect": { "error": { "kind": "invalid", "messagePrefix": "os/write: fd: Bad file descriptor (os error " } } },
    { "name": "close the fd", "op": "os/close", "args": [3], "expect": { "ok": {} } },
    { "name": "close again", "op": "os/close", "args": [3], "expect": { "error": { "kind": "closed", "message": "os/close: not an open handle" } } },
    { "name": "read a closed fd", "op": "os/read", "args": [3, 1], "expect": { "error": { "kind": "closed", "message": "os/read: fd 3 is not open" } } },
    { "name": "missing file", "op": "os/read-file", "args": ["${tmp}/missing.txt"], "expect": { "error": { "kind": "not-found", "message": "os/read-file: ${tmp}/missing.txt: No such file or directory (os error 2)" } } },
    { "name": "outside the grant", "op": "os/read-file", "args": ["/etc/hostname"], "expect": { "error": { "kind": "denied", "message": "os/read-file: /etc/hostname is not granted for Read" } } },
    { "name": "climbing out", "op": "os/read-file", "args": ["${tmp}/../x"], "expect": { "error": { "kind": "denied", "messagePrefix": "os/read-file: " } } },
    { "name": "relative without a working directory", "op": "os/read-file", "args": ["a.txt"], "expect": { "error": { "kind": "invalid", "message": "os/read-file: a.txt is relative and no working directory is set (os/chdir)" } } },
    { "name": "bad base64", "op": "os/write-file", "args": ["${tmp}/z.txt", "@@@@"], "expect": { "error": { "kind": "invalid", "messagePrefix": "os/write-file: argument 2 is not standard base64: " } } },
    { "name": "bad flags", "op": "os/open", "args": ["${tmp}/a.txt", "zz"], "expect": { "error": { "kind": "invalid", "message": "os/open: flags \"zz\" must be one of r r+ w w+ a a+, optionally followed by x" } } },
    { "name": "rename", "op": "os/rename", "args": ["${tmp}/a.txt", "${tmp}/c.txt"], "expect": { "ok": {} } },
    { "name": "truncate by path", "op": "os/truncate", "args": ["${tmp}/c.txt", 5], "expect": { "ok": {} } },
    { "name": "truncated content", "op": "os/read-file", "args": ["${tmp}/c.txt"], "expect": { "ok": { "data": "aGVsbG8=" } } },
    { "name": "remove a file", "op": "os/remove", "args": ["${tmp}/c.txt"], "expect": { "ok": {} } },
    { "name": "remove refuses a directory", "op": "os/remove", "args": ["${tmp}/d"], "expect": { "error": { "kind": "invalid", "message": "os/remove: ${tmp}/d is a directory; use os/rmdir" } } },
    { "name": "rmdir refuses a full directory", "op": "os/rmdir", "args": ["${tmp}/d"], "expect": { "error": { "kind": "io", "messagePrefix": "os/rmdir: ${tmp}/d: Directory not empty (os error " } } },
    { "name": "rmdir recursive", "op": "os/rmdir", "args": ["${tmp}/d", true], "expect": { "ok": {} } },
    { "name": "gone", "op": "os/exists", "args": ["${tmp}/d"], "expect": { "ok": { "ok": false } } },
    { "name": "watch-files is unsupported", "op": "os/watch-files", "args": ["${tmp}"], "expect": { "error": { "kind": "unsupported", "message": "os/watch-files: streaming host not implemented" } } },

    { "name": "spawn echo", "op": "os/spawn", "args": ["echo", ["hi"], { "stdout": "pipe" }], "bind": { "pid": "pid", "outFd": "stdout" }, "expect": { "ok": { "pid": { "$number": true }, "stdout": { "$number": true } } } },
    { "name": "wait", "op": "os/wait", "args": [{ "$var": "pid" }], "expect": { "ok": { "code": 0 } } },
    { "name": "read its output", "op": "os/read", "args": [{ "$var": "outFd" }, 64], "expect": { "ok": { "data": "aGkK", "eof": false } } },
    { "name": "then eof", "op": "os/read", "args": [{ "$var": "outFd" }, 64], "expect": { "ok": { "data": "", "eof": true } } },
    { "name": "close the pipe", "op": "os/close", "args": [{ "$var": "outFd" }], "expect": { "ok": {} } },
    { "name": "waiting twice", "op": "os/wait", "args": [{ "$var": "pid" }], "expect": { "error": { "kind": "closed", "message": "os/wait: pid ${pid} is not a spawned process" } } },
    { "name": "command not granted", "op": "os/spawn", "args": ["ls", []], "expect": { "error": { "kind": "denied", "message": "os/spawn: command ls is not granted" } } },
    { "name": "command not found", "op": "os/spawn", "args": ["nope-not-a-command", []], "expect": { "error": { "kind": "not-found", "message": "os/spawn: No such file or directory (os error 2)" } } },
    { "name": "unknown option", "op": "os/spawn", "args": ["echo", [], { "shell": true }], "expect": { "error": { "kind": "invalid", "message": "os/spawn: unknown option shell" } } },
    { "name": "spawn sleep", "op": "os/spawn", "args": ["sleep", ["30"]], "bind": { "sleeper": "pid" }, "expect": { "ok": { "pid": { "$number": true } } } },
    { "name": "bad signal", "op": "os/kill", "args": [{ "$var": "sleeper" }, "NOPE"], "expect": { "error": { "kind": "invalid", "message": "os/kill: signal must be one of TERM, KILL, INT, HUP, QUIT, USR1, USR2, STOP, CONT (or its number)" } } },
    { "name": "kill", "op": "os/kill", "args": [{ "$var": "sleeper" }, "TERM"], "expect": { "ok": {} } },
    { "name": "wait for the signal", "op": "os/wait", "args": [{ "$var": "sleeper" }], "expect": { "ok": { "signal": 15 } } },
    { "name": "kill an unknown pid", "op": "os/kill", "args": [999999, "TERM"], "expect": { "error": { "kind": "closed", "message": "os/kill: pid 999999 is not a spawned process" } } },
    { "name": "pid", "op": "os/pid", "args": [], "expect": { "ok": { "pid": { "$number": true } } } },
    { "name": "getenv not granted", "op": "os/getenv", "args": ["PATH"], "expect": { "error": { "kind": "denied", "message": "os/getenv: environment PATH is not granted" } } },
    { "name": "setenv", "op": "os/setenv", "args": ["FOO", "bar"], "expect": { "ok": {} } },
    { "name": "getenv", "op": "os/getenv", "args": ["FOO"], "expect": { "ok": { "value": "bar" } } },
    { "name": "unsetenv", "op": "os/unsetenv", "args": ["FOO"], "expect": { "ok": {} } },
    { "name": "getenv after unset", "op": "os/getenv", "args": ["FOO"], "expect": { "ok": { "value": null } } },
    { "name": "stdout without the grant", "op": "os/stdout-write", "args": ["aA=="], "expect": { "error": { "kind": "denied", "message": "os/stdout-write: stdio is not granted" } } },

    { "name": "connect", "op": "os/tcp-connect", "args": ["127.0.0.1", { "$var": "port" }], "bind": { "sock": "sock" }, "expect": { "ok": { "sock": { "$number": true } } } },
    { "name": "send", "op": "os/send", "args": [{ "$var": "sock" }, "cGluZw=="], "expect": { "ok": { "bytes": 4 } } },
    { "name": "recv the echo", "op": "os/recv", "args": [{ "$var": "sock" }, 64], "expect": { "ok": { "data": "cGluZw==", "eof": false } } },
    { "name": "shutdown", "op": "os/shutdown", "args": [{ "$var": "sock" }], "expect": { "ok": {} } },
    { "name": "recv after shutdown is eof", "op": "os/recv", "args": [{ "$var": "sock" }, 64], "expect": { "ok": { "data": "", "eof": true } } },
    { "name": "close the socket", "op": "os/close", "args": [{ "$var": "sock" }], "expect": { "ok": {} } },
    { "name": "send on a closed socket", "op": "os/send", "args": [{ "$var": "sock" }, "eA=="], "expect": { "error": { "kind": "closed", "message": "os/send: not an open socket" } } },
    { "name": "connect not granted", "op": "os/tcp-connect", "args": ["127.0.0.1", 1], "expect": { "error": { "kind": "denied", "message": "os/tcp-connect: 127.0.0.1:1 is not granted" } } },
    { "name": "connect refused", "op": "os/tcp-connect", "args": ["127.0.0.1", { "$var": "closedPort" }], "expect": { "error": { "kind": "io", "messagePrefix": "os/tcp-connect: Connection refused (os error " } } },
    { "name": "a host name must resolve public", "op": "os/tcp-connect", "args": ["localhost", { "$var": "port" }], "expect": { "error": { "kind": "denied", "messagePrefix": "os/tcp-connect: localhost resolves to " } } },
    { "name": "dns-resolve a literal", "op": "os/dns-resolve", "args": ["127.0.0.1"], "expect": { "ok": { "addresses": ["127.0.0.1"] } } },
    { "name": "dns-resolve not granted", "op": "os/dns-resolve", "args": ["example.org"], "expect": { "error": { "kind": "denied", "message": "os/dns-resolve: example.org:0 is not granted" } } },
    { "name": "tcp-listen is unsupported", "op": "os/tcp-listen", "args": ["127.0.0.1", 0], "expect": { "error": { "kind": "unsupported", "message": "os/tcp-listen: streaming host not implemented" } } },

    { "name": "spawn echo for the deferred asks", "op": "os/spawn", "args": ["echo", ["hi"], { "stdout": "pipe" }], "bind": { "pidD": "pid", "outD": "stdout" }, "expect": { "ok": { "pid": { "$number": true }, "stdout": { "$number": true } } } },
    { "name": "a keyed wait is deferred and its completion carries the exit and the key", "op": "os/wait", "key": "w1", "args": [{ "$var": "pidD" }], "deferred": { "event": "DONE", "payload": { "code": 0, "key": "w1" } } },
    { "name": "a keyed pipe read is deferred", "op": "os/read", "key": "r1", "args": [{ "$var": "outD" }, 64], "deferred": { "event": "DONE", "payload": { "data": "aGkK", "eof": false, "key": "r1" } } },
    { "name": "a keyed pipe read at the end is deferred with eof", "op": "os/read", "key": "r2", "args": [{ "$var": "outD" }, 64], "deferred": { "event": "DONE", "payload": { "data": "", "eof": true, "key": "r2" } } },
    { "name": "close the deferred pipe", "op": "os/close", "args": [{ "$var": "outD" }], "expect": { "ok": {} } },
    { "name": "write a file for the deferred read", "op": "os/write-file", "args": ["${tmp}/deferred.txt", "aGVsbG8="], "expect": { "ok": { "bytes": 5 } } },
    { "name": "open it", "op": "os/open", "args": ["${tmp}/deferred.txt", "r"], "bind": { "fdD": "fd" }, "expect": { "ok": { "fd": { "$number": true } } } },
    { "name": "a keyed file read is deferred too", "op": "os/read", "key": "r3", "args": [{ "$var": "fdD" }, 5], "deferred": { "event": "DONE", "payload": { "data": "aGVsbG8=", "eof": false, "key": "r3" } } },
    { "name": "close the deferred file", "op": "os/close", "args": [{ "$var": "fdD" }], "expect": { "ok": {} } },
    { "name": "a keyed read of a closed fd fails in place", "op": "os/read", "key": "r4", "args": [{ "$var": "fdD" }, 1], "expect": { "error": { "kind": "closed", "message": "os/read: fd ${fdD} is not open" } } },
    { "name": "spawn sleep for the cancelled wait", "op": "os/spawn", "args": ["sleep", ["30"]], "bind": { "pidC": "pid" }, "expect": { "ok": { "pid": { "$number": true } } } },
    { "name": "a keyed wait on a running child is deferred", "op": "os/wait", "key": "w2", "args": [{ "$var": "pidC" }], "deferred": "pending" },
    { "name": "a second ask on a pending key fails in place", "op": "os/wait", "key": "w2", "args": [{ "$var": "pidC" }], "expect": { "error": { "kind": "invalid", "message": "os/wait: key w2 already has a completion pending" } } },
    { "name": "cancelling the key drops the pending completion", "cancel": "w2", "cancelled": true },
    { "name": "cancelling it again finds nothing pending", "cancel": "w2", "cancelled": false },
    { "name": "kill the cancelled child", "op": "os/kill", "args": [{ "$var": "pidC" }, "TERM"], "expect": { "ok": {} } },
    { "name": "the cancelled child was left unreaped for a later wait", "op": "os/wait", "args": [{ "$var": "pidC" }], "expect": { "ok": { "signal": 15 } } },
    { "name": "a keyed wait on an unknown pid fails in place", "op": "os/wait", "key": "w3", "args": [999999], "expect": { "error": { "kind": "closed", "message": "os/wait: pid 999999 is not a spawned process" } } },
    { "name": "a keyed op that never defers is answered in place", "op": "os/pid", "key": "p1", "args": [], "expect": { "ok": { "pid": { "$number": true } } } },
    { "name": "connect for the deferred recv", "op": "os/tcp-connect", "args": ["127.0.0.1", { "$var": "port" }], "bind": { "sockD": "sock" }, "expect": { "ok": { "sock": { "$number": true } } } },
    { "name": "send", "op": "os/send", "args": [{ "$var": "sockD" }, "cGluZw=="], "expect": { "ok": { "bytes": 4 } } },
    { "name": "a keyed recv is deferred", "op": "os/recv", "key": "n1", "args": [{ "$var": "sockD" }, 64], "deferred": { "event": "DONE", "payload": { "data": "cGluZw==", "eof": false, "key": "n1" } } },
    { "name": "close the deferred socket", "op": "os/close", "args": [{ "$var": "sockD" }], "expect": { "ok": {} } }
  ]
}
