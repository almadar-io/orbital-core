                        "srcN": "@event.payload.n",
                        "from": "@fromState",
                        "to": "@toState",
                        "state": "@state",
                        "seen": [
                          "array/len",
                          "@prevEvents"
                        ]
                      }
                    ]
                  ]
                }
              ]
