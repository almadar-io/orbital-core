                "event": "X",
                "triggers": "GOT",
                "source": {
                  "kind": "trait",
                  "trait": "Src"
                }
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "GOT",
                  "name": "GOT"
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
