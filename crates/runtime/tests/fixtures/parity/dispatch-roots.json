              ],
              "events": [
                {
                  "key": "STEP",
                  "name": "STEP"
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "processing",
                  "event": "STEP",
                  "guard": [
                    "not",
                    [
                      "array/includes",
                      "@prevStates",
                      "processing"
                    ]
                  ],
                  "effects": [
                    [
                      "emit",
                      "ACK_R",
                      {
                        "to": "@toState"
                      }
                    ]
                  ]
                },
                {
                  "from": "processing",
                  "to": "idle",
                  "event": "STEP",
                  "effects": [
                    [
                      "emit",
                      "ACK_R",
                      {
                        "to": "@toState"
                      }
                    ]
