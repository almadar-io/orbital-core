              {
                "event": "X",
                "triggers": "GOT",
                "source": {
                  "kind": "trait",
                  "trait": "Src"
                },
                "guard": [
                  "not",
                  [
                    "array/includes",
                    [
                      "array/map",
                      "@prevEvents",
                      [
                        "fn",
                        "e",
                        [
                          "object/get",
                          "@e",
                          "event"
                        ]
                      ]
                    ],
                    "X"
                  ]
                ]
              }
            ],
            "stateMachine": {
              "states": [
                {
                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "GOT",
                  "name": "GOT"
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "GOT",
                  "effects": [
                    [
                      "emit",
                      "ACK_TWIN",
                      {
                        "n": "@payload.n"
                      }
                    ]
