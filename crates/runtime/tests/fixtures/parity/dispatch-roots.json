                  "name": "idle",
                  "isInitial": true
                }
              ],
              "events": [
                {
                  "key": "GOT",
                  "name": "GOT"
                }
              ],
              "transitions": [
                {
                  "from": "idle",
                  "to": "idle",
                  "event": "GOT",
                  "effects": [
                    [
                      "emit",
