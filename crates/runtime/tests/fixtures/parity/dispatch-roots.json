                    [
                      "=",
                      "@toState",
                      "seen"
                    ],
                    [
                      "=",
                      "@state",
                      "idle"
                    ]
                  ],
                  "effects": [
                    [
                      "emit",
                      "ACK_PROV",
                      {
                        "srcTrait": "@event.source.trait",
                        "srcEvent": "@event.event",
                        "srcN": "@event.payload.n",
                        "from": "@fromState",
                        "to": "@toState",
                        "state": "@state",
