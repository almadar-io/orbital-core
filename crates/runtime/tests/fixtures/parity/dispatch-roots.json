                "triggers": "GOT",
                "source": {
                  "kind": "trait",
                  "trait": "Src"
                },
                "guard": [
                  "not",
                  [
                    "array/includes",
                    [
                      "array/map",
                      "@prevEvents",
                      [
                        "fn",
                        "e",
                        [
                          "object/get",
                          "@e",
                          "event"
                        ]
                      ]
                    ],
                    "X"
                  ]
                ]
              }
            ],
            "stateMachine": {
              "states": [
