    {
      "name": "const-compare-true-or",
      "why": "a comparison of two same-kind constants is decided at compile time, and an or that holds is true whatever follows it (the evaluator stops at the first truthy operand)",
      "bindings": {
        "payload": {
          "value": ""
        }
      },
      "sexpr": {
        "filter": [
          "or",
          [
            "=",
            "@payload.value",
            ""
          ],
          [
            "=",
            [
              "object/get",
              "@entity",
              "status"
            ],
            "open"
          ]
        ]
      },
      "expect": {
        "compiled": {
          "filter": {
            "kind": "const",
            "value": true
          }
        }
      }
    },
    {
      "name": "const-compare-false-or",
      "why": "a constant comparison that is false is a false operand, the rest of the or still compiles",
      "bindings": {
        "payload": {
          "value": "open"
        }
      },
      "sexpr": {
        "filter": [
          "or",
          [
            "=",
            "@payload.value",
            ""
          ],
          [
            "=",
            [
              "object/get",
              "@entity",
              "status"
            ],
            "open"
          ]
        ]
      },
      "expect": {
        "compiled": {
          "filter": {
            "kind": "any",
            "of": [
              {
                "kind": "const",
                "value": false
              },
              {
                "kind": "compare",
                "field": "status",
                "op": "==",
                "value": "open"
              }
            ]
          }
        }
      }
    },
    {
      "name": "const-compare-skips-unresolved-sibling",
