{
  "theme": "almadar-website",
  "mode": "light",
  "preset": {
    "name": "almadar-website",
    "displayName": "Almadar Website",
    "tokens": {
      "motion": {
        "durations": {
          "instant": "0ms",
          "fast": "var(--transition-fast)",
          "normal": "var(--transition-normal)",
          "slow": "var(--transition-slow)",
          "dramatic": "600ms"
        },
        "easings": {
          "linear": "linear",
          "standard": "var(--transition-timing)",
          "emphasized": "cubic-bezier(0.2, 0, 0, 1)",
          "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
        }
      },
      "iconography": {
        "family": "lucide",
        "strokeWidth": "1.75",
        "defaultSize": "16px"
      },
      "elevation": {
        "cardElevation": "var(--shadow-sm)",
        "popoverElevation": "var(--shadow-main)",
        "dialogElevation": "var(--shadow-lg)",
        "toastElevation": "var(--shadow-main)"
      },
      "geometry": {
        "radiusContainer": "var(--radius-md)",
        "radiusInteractive": "var(--radius-md)",
        "radiusPill": "var(--radius-full)",
        "borderHairline": "1px",
        "borderStandard": "var(--border-width)",
        "borderHeavy": "var(--border-width-thick)"
      },
      "colors": {
        "primary": "#0f766e",
