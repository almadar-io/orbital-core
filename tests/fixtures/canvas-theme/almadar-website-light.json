        "lightAmbient": "0.6",
        "lightKey": "0.9",
        "lightKeyColor": "#fff6e0",
        "fog": "0.05"
      },
      "surface": {
        "edgeMask": "url(\"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1440 100' preserveAspectRatio='none'><path d='M0 60 C240 100 480 100 720 60 C960 20 1200 20 1440 60 V100 H0 Z'/></svg>\")",
