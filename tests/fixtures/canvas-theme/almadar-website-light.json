        "sm": "4px",
        "md": "8px",
        "lg": "12px",
        "xl": "16px",
        "full": "9999px"
      },
      "shadows": {
        "main": "0 4px 14px rgba(15, 23, 42, 0.1), 0 1px 3px rgba(15, 23, 42, 0.06)",
        "sm": "0 1px 3px rgba(15, 23, 42, 0.08)",
        "lg": "0 10px 15px rgba(15, 23, 42, 0.15)",
