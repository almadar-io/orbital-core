{
  "theme": "game-adventure",
  "mode": "light",
  "preset": {
    "name": "game-adventure",
    "displayName": "Game: Adventure",
    "tokens": {},
    "variants": {
      "dark": {
        "density": {
          "spacing": {
            "space0": "0px",
            "space1": "4px",
            "space2": "8px",
            "space3": "12px",
            "space4": "16px",
            "space5": "20px",
            "space6": "24px",
            "space7": "28px",
            "space8": "32px",
            "space9": "36px",
            "space10": "40px",
            "space11": "44px",
            "space12": "48px"
          },
          "buttonHeightSm": "28px",
          "buttonHeightMd": "36px",
          "buttonHeightLg": "44px",
          "inputHeightSm": "28px",
          "inputHeightMd": "36px",
          "inputHeightLg": "44px",
          "rowHeightCompact": "32px",
          "rowHeightNormal": "40px",
          "rowHeightSpacious": "48px",
          "cardPaddingSm": "12px",
          "cardPaddingMd": "16px",
          "cardPaddingLg": "24px",
          "dialogPadding": "24px",
          "sectionGap": "32px"
        },
        "typeScale": {
          "displayFamily": "var(--font-family)",
          "bodyFamily": "var(--font-family)",
          "monoFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
          "scale": {
            "xs": {
              "size": "12px",
              "lineHeight": "16px"
            },
            "sm": {
              "size": "14px",
              "lineHeight": "20px"
            },
            "base": {
              "size": "16px",
              "lineHeight": "24px"
            },
            "lg": {
              "size": "18px",
              "lineHeight": "28px"
            },
            "xl": {
              "size": "20px",
              "lineHeight": "28px"
            },
            "2xl": {
              "size": "24px",
              "lineHeight": "32px"
            },
            "3xl": {
              "size": "30px",
              "lineHeight": "36px"
            },
            "4xl": {
              "size": "36px",
              "lineHeight": "40px"
            },
            "display-1": {
              "size": "48px",
              "lineHeight": "52px"
            },
            "display-2": {
              "size": "60px",
              "lineHeight": "64px"
            }
          },
          "intents": {
            "headingMajor": {
              "slot": "display",
              "size": "2xl",
              "weight": "bold"
            },
            "headingMinor": {
              "slot": "display",
              "size": "lg",
              "weight": "bold"
            },
            "bodyEmphasis": {
              "slot": "body",
              "size": "base",
              "weight": "medium"
            },
            "bodyDefault": {
              "slot": "body",
              "size": "sm",
              "weight": "normal"
            },
            "bodyQuiet": {
              "slot": "body",
              "size": "sm",
              "weight": "normal"
            },
            "caption": {
              "slot": "body",
              "size": "xs",
              "weight": "normal"
            },
            "numeric": {
              "slot": "mono",
              "size": "sm",
              "weight": "medium"
            }
          },
          "headingWeight": "700",
          "headingTransform": "uppercase",
          "headingTracking": "0.05em",
          "headingStyle": "normal"
        },
        "motion": {
          "durations": {
            "instant": "0ms",
            "fast": "var(--transition-fast)",
            "normal": "var(--transition-normal)",
            "slow": "var(--transition-slow)",
            "dramatic": "600ms"
          },
          "easings": {
            "linear": "linear",
            "standard": "cubic-bezier(0.34, 1.3, 0.64, 1)",
            "emphasized": "cubic-bezier(0.2, 0, 0, 1)",
            "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
          },
          "shapes": {
            "modalEnter": "scale(0.8)",
            "modalExit": "scale(0.8)",
            "pageEnter": "translateY(12px)",
            "popoverEnter": "scale(0.9)",
            "popoverExit": "scale(0.9)",
            "toastEnter": "translateY(20px)",
            "toastExit": "translateY(20px)"
          }
        },
        "iconography": {
          "family": "fa-solid",
          "strokeWidth": "0",
          "defaultSize": "16px"
        },
        "elevation": {
          "cardElevation": "var(--shadow-main)",
          "popoverElevation": "var(--shadow-lg)",
          "dialogElevation": "var(--shadow-lg)",
          "toastElevation": "var(--shadow-main)",
          "interactiveElevation": "var(--shadow-sm)",
          "pressedElevation": "var(--shadow-active)"
        },
        "geometry": {
          "radiusContainer": "var(--radius-lg)",
          "radiusInteractive": "var(--radius-md)",
          "radiusPill": "var(--radius-full)",
          "cornerShape": "round",
          "cornerShapePill": "round",
          "borderStyle": "outset",
          "borderStyleInteractive": "outset",
          "borderHairline": "1px",
          "borderStandard": "var(--border-width)",
          "borderHeavy": "var(--border-width-thick)"
        },
        "colors": {
          "primary": "#b5793a",
          "primary-hover": "#c98d4c",
          "primary-foreground": "#241608",
          "secondary": "#3a2712",
          "secondary-hover": "#4a3319",
          "secondary-foreground": "#f3e3c4",
          "accent": "#e0a52c",
          "accent-foreground": "#241608",
          "muted": "#e8d6ae",
          "muted-foreground": "#6b4f2a",
          "background": "#241608",
          "foreground": "#f3e3c4",
          "card": "#fff1d2",
          "card-foreground": "#4a2f14",
          "surface": "#2e1d0d",
          "border": "#7a5228",
          "input": "#3a2712",
          "ring": "#e0a52c",
          "error": "#d9534f",
          "error-foreground": "#1a0808",
          "success": "#7ba05b",
          "success-foreground": "#0d1a08",
          "warning": "#e0a52c",
          "warning-foreground": "#241608",
          "info": "#b5793a",
          "info-foreground": "#241608",
          "scrim": "rgba(0, 0, 0, 0.7)",
          "diagram-ink": "#3a2712",
          "diagram-label": "#4a3319",
          "diagram-guide": "#9a7a4a",
          "diagram-axis": "#6b4f2a",
          "diagram-grid": "#e3cfa3",
          "diagram-highlight": "#ab3f20",
          "diagram-fill": "#f3dcae",
          "series-1": "#701e08",
          "series-2": "#2f5f8a",
          "series-3": "#5f7f2a",
          "series-4": "#7a3f7a",
          "series-5": "#b0702a",
          "series-6": "#2a7a6a",
          "series-7": "#8a2a3a",
          "series-8": "#5a5a2a"
        },
        "radii": {
          "none": "0px",
          "sm": "8px",
          "md": "10px",
          "lg": "14px",
          "xl": "18px",
          "full": "9999px"
        },
        "shadows": {
          "main": "inset 0 2px 0 rgba(255,220,160,0.28), inset 0 -3px 0 rgba(0,0,0,0.35), 0 3px 8px rgba(0,0,0,0.55)",
          "sm": "inset 0 1px 0 rgba(255,220,160,0.25), inset 0 -2px 0 rgba(0,0,0,0.3), 0 2px 4px rgba(0,0,0,0.5)",
          "lg": "inset 0 2px 0 rgba(255,220,160,0.3), inset 0 -4px 0 rgba(0,0,0,0.4), 0 10px 24px rgba(0,0,0,0.6)",
          "inner": "inset 0 3px 6px rgba(0,0,0,0.5)",
          "none": "none",
          "hover": "inset 0 2px 0 rgba(255,220,160,0.4), inset 0 -3px 0 rgba(0,0,0,0.35), 0 5px 12px rgba(0,0,0,0.55)",
          "active": "inset 0 3px 0 rgba(0,0,0,0.45)"
        },
        "typography": {
          "border-width": "3px",
          "border-width-thin": "2px",
          "border-width-thick": "4px",
          "game-panel-border-image": "url('https://almadar-kflow-assets.web.app/shared/ui-game-shell/kenney-ui-pack-adventure/ui/panel_brownimg.png')",
          "game-panel-border-image-slice": "17 fill",
          "game-panel-border-image-width": "14px",
          "font-family": "\"Kenney Blocks\", ui-sans-serif, system-ui, sans-serif",
          "font-weight-normal": "400",
          "font-weight-medium": "500",
          "font-weight-bold": "700",
          "letter-spacing": "0.02em",
          "line-height": "1.5",
          "icon-color": "#e0a52c",
          "transition-fast": "100ms",
          "transition-normal": "200ms",
          "transition-slow": "400ms",
          "transition-timing": "cubic-bezier(0.4, 0, 0.2, 1)",
          "hover-scale": "1.01",
          "hover-translate-y": "-1px",
          "hover-translate-x": "0",
          "active-scale": "0.99",
          "active-translate-y": "0",
          "focus-ring-width": "2px",
          "focus-ring-offset": "2px",
          "focus-ring-color": "#e0a52c"
        },
        "surface": {
          "cardImage": "linear-gradient(180deg, rgba(122,82,40,0.06), rgba(122,82,40,0.14))",
          "pageImage": "repeating-linear-gradient(90deg, rgba(0,0,0,0.10) 0px, rgba(0,0,0,0.10) 2px, transparent 2px, transparent 9px)",
          "pageImageSize": "auto"
        }
      }
    }
