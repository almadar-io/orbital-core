{
  "theme": "game-ui-pack",
  "mode": "light",
  "preset": {
    "name": "game-ui-pack",
    "displayName": "Game: Flat UI",
    "tokens": {},
    "variants": {
      "dark": {
        "density": {
          "spacing": {
            "space0": "0px",
            "space1": "4px",
            "space2": "8px",
            "space3": "12px",
            "space4": "16px",
            "space5": "20px",
            "space6": "24px",
            "space7": "28px",
            "space8": "32px",
            "space9": "36px",
            "space10": "40px",
            "space11": "44px",
            "space12": "48px"
          },
          "buttonHeightSm": "28px",
          "buttonHeightMd": "36px",
          "buttonHeightLg": "44px",
          "inputHeightSm": "28px",
          "inputHeightMd": "36px",
          "inputHeightLg": "44px",
          "rowHeightCompact": "32px",
          "rowHeightNormal": "40px",
          "rowHeightSpacious": "48px",
          "cardPaddingSm": "12px",
          "cardPaddingMd": "16px",
          "cardPaddingLg": "24px",
          "dialogPadding": "24px",
          "sectionGap": "32px"
        },
        "typeScale": {
          "displayFamily": "var(--font-family)",
          "bodyFamily": "var(--font-family)",
          "monoFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
          "scale": {
            "xs": {
              "size": "12px",
              "lineHeight": "16px"
            },
            "sm": {
              "size": "14px",
              "lineHeight": "20px"
            },
            "base": {
              "size": "16px",
              "lineHeight": "24px"
            },
            "lg": {
              "size": "18px",
              "lineHeight": "28px"
            },
            "xl": {
              "size": "20px",
              "lineHeight": "28px"
            },
            "2xl": {
              "size": "24px",
              "lineHeight": "32px"
            },
            "3xl": {
              "size": "30px",
              "lineHeight": "36px"
            },
            "4xl": {
              "size": "36px",
              "lineHeight": "40px"
            },
            "display-1": {
              "size": "48px",
              "lineHeight": "52px"
            },
            "display-2": {
              "size": "60px",
              "lineHeight": "64px"
            }
          },
          "intents": {
            "headingMajor": {
              "slot": "display",
              "size": "2xl",
              "weight": "bold"
            },
            "headingMinor": {
              "slot": "display",
              "size": "lg",
              "weight": "bold"
            },
            "bodyEmphasis": {
              "slot": "body",
              "size": "base",
              "weight": "medium"
            },
            "bodyDefault": {
              "slot": "body",
              "size": "sm",
              "weight": "normal"
            },
            "bodyQuiet": {
              "slot": "body",
              "size": "sm",
              "weight": "normal"
            },
            "caption": {
              "slot": "body",
              "size": "xs",
              "weight": "normal"
            },
            "numeric": {
              "slot": "mono",
              "size": "sm",
              "weight": "medium"
            }
          },
          "headingWeight": "600",
          "headingTransform": "none",
          "headingTracking": "0.02em",
          "headingStyle": "normal",
          "headingShadow": "none"
        },
        "motion": {
          "durations": {
            "instant": "0ms",
            "fast": "var(--transition-fast)",
            "normal": "var(--transition-normal)",
            "slow": "var(--transition-slow)",
            "dramatic": "600ms"
          },
          "easings": {
            "linear": "linear",
            "standard": "cubic-bezier(0.34, 1.56, 0.64, 1)",
            "emphasized": "cubic-bezier(0.34, 1.56, 0.64, 1)",
            "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
          },
          "shapes": {
            "modalEnter": "translateY(-24px)",
            "modalExit": "translateY(-24px)",
            "pageEnter": "translateY(12px)",
            "popoverEnter": "scale(0.9)",
            "popoverExit": "scale(0.9)",
            "toastEnter": "translateY(-20px)",
            "toastExit": "translateY(-20px)"
          }
        },
        "iconography": {
          "family": "lucide",
          "strokeWidth": "2.5",
          "defaultSize": "16px"
        },
        "elevation": {
          "cardElevation": "var(--shadow-sm)",
          "popoverElevation": "var(--shadow-main)",
          "dialogElevation": "var(--shadow-lg)",
          "toastElevation": "var(--shadow-main)",
          "interactiveElevation": "var(--shadow-main)",
          "pressedElevation": "var(--shadow-active)"
        },
        "geometry": {
          "radiusContainer": "var(--radius-lg)",
          "radiusInteractive": "var(--radius-md)",
          "radiusPill": "var(--radius-full)",
          "cornerShape": "round",
          "cornerShapePill": "round",
          "borderStyle": "none",
          "borderStyleInteractive": "none",
          "borderHairline": "1px",
          "borderStandard": "var(--border-width)",
          "borderHeavy": "var(--border-width-thick)"
        },
        "colors": {
          "primary": "#2ea7e1",
          "primary-hover": "#4fb8ea",
          "primary-foreground": "#06202c",
          "secondary": "#3a3f47",
          "secondary-hover": "#474d56",
          "secondary-foreground": "#f2f3f4",
          "accent": "#ffb703",
          "accent-foreground": "#241a00",
          "muted": "#b9bec6",
          "muted-foreground": "#454a51",
          "background": "#1b1e22",
          "foreground": "#f2f3f4",
          "card": "#eeeeee",
          "card-foreground": "#22262b",
          "surface": "#24272c",
          "border": "#999999",
          "input": "#3a3f47",
          "ring": "#2ea7e1",
          "error": "#ff5c5c",
          "error-foreground": "#1a0808",
          "success": "#4ade80",
          "success-foreground": "#082014",
          "warning": "#ffb703",
          "warning-foreground": "#241a00",
          "info": "#2ea7e1",
          "info-foreground": "#06202c",
          "scrim": "rgba(0, 0, 0, 0.7)",
          "diagram-ink": "#1b1e22",
          "diagram-label": "#2e3238",
          "diagram-guide": "#8a9099",
          "diagram-axis": "#454a51",
          "diagram-grid": "#d0d4da",
          "diagram-highlight": "#e85d04",
          "diagram-fill": "#dde1e6",
          "series-1": "#1988c7",
          "series-2": "#db2c3d",
          "series-3": "#1b9486",
          "series-4": "#8338ec",
          "series-5": "#c03806",
          "series-6": "#4978f5",
          "series-7": "#619045",
          "series-8": "#b5179e"
        },
        "radii": {
          "none": "0px",
          "sm": "10px",
          "md": "12px",
          "lg": "16px",
          "xl": "22px",
          "full": "9999px"
        },
        "shadows": {
          "main": "0 4px 0 0 rgba(0,0,0,0.45)",
          "sm": "0 2px 0 0 rgba(0,0,0,0.45)",
          "lg": "0 6px 0 0 rgba(0,0,0,0.5)",
          "inner": "inset 0 2px 0 0 rgba(0,0,0,0.35)",
          "none": "none",
          "hover": "0 6px 0 0 rgba(0,0,0,0.45)",
          "active": "0 1px 0 0 rgba(0,0,0,0.5)"
        },
        "typography": {
          "border-width": "1px",
          "border-width-thin": "1px",
          "border-width-thick": "2px",
          "game-panel-border-image": "url('https://almadar-kflow-assets.web.app/shared/ui-game-shell/kenney-ui-pack/ui/grey_panel.png')",
          "game-panel-border-image-slice": "26 fill",
          "game-panel-border-image-width": "22px",
          "game-button-bg-image": "url('https://almadar-kflow-assets.web.app/shared/ui-game-shell/kenney-ui-pack/ui/grey_button00.png')",
          "font-family": "\"Kenney Future\", ui-sans-serif, system-ui, sans-serif",
          "font-weight-normal": "400",
          "font-weight-medium": "500",
          "font-weight-bold": "700",
          "letter-spacing": "0.01em",
          "line-height": "1.5",
          "icon-color": "#2ea7e1",
          "transition-fast": "100ms",
          "transition-normal": "200ms",
          "transition-slow": "400ms",
          "transition-timing": "cubic-bezier(0.4, 0, 0.2, 1)",
          "hover-scale": "1.01",
          "hover-translate-y": "-1px",
          "hover-translate-x": "0",
          "active-scale": "0.99",
          "active-translate-y": "0",
          "focus-ring-width": "2px",
          "focus-ring-offset": "2px",
          "focus-ring-color": "#2ea7e1"
        },
        "surface": {}
      }
    }
  },
  "canvasTheme": {
    "ground": "transparent",
    "surfaces": {
      "muted": "transparent",
      "card": "transparent",
      "onPrimary": "transparent"
    },
    "tones": {
      "ink": "currentColor",
      "label": "currentColor",
      "guide": "currentColor",
      "axis": "currentColor",
      "grid": "currentColor",
      "highlight": "currentColor",
      "fill": "currentColor",
      "series-1": "currentColor",
      "series-2": "currentColor",
      "series-3": "currentColor",
      "series-4": "currentColor",
      "series-5": "currentColor",
      "series-6": "currentColor",
      "series-7": "currentColor",
      "series-8": "currentColor",
      "primary": "currentColor",
      "accent": "currentColor",
      "success": "currentColor",
      "warning": "currentColor",
      "error": "currentColor",
      "info": "currentColor",
      "muted": "currentColor"
    },
    "series": [
      "currentColor",
      "currentColor",
      "currentColor",
      "currentColor",
      "currentColor",
      "currentColor",
      "currentColor",
      "currentColor"
    ],
    "strokes": {
      "thin": 1,
      "normal": 1.5,
      "bold": 3
    },
    "lineCap": "round",
    "lineJoin": "round",
    "dash": [
      6,
      4
    ],
    "dot": [
      1,
      4
    ],
    "fillStyle": "tint",
    "fillOpacity": 0.18,
    "roughness": 0,
    "glow": 0,
    "shadow": null,
    "marker": "triangle",
    "faces": {
      "body": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
      "display": "\"Söhne\", \"Inter Display\", -apple-system, BlinkMacSystemFont, sans-serif",
      "mono": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "label": {
      "font": "body",
      "size": "sm",
      "weight": "500",
      "uppercase": false
