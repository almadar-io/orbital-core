    "text": {
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 20,
      "xl": 24,
      "2xl": 32
    },
    "corner": 4,
    "motion": {
      "enabled": true,
      "fastMs": 150,
      "normalMs": 250,
      "slowMs": 400,
      "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
    },
    "scene": {
      "roughness": 0.6,
      "metalness": 0,
      "flat": false,
      "outline": 0,
      "ambient": 0.55,
      "key": 1,
