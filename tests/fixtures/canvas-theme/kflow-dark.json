{
  "theme": "kflow",
  "mode": "dark",
  "preset": {
    "name": "kflow",
    "displayName": "KFlow",
    "tokens": {
      "motion": {
        "durations": {
          "instant": "0ms",
          "fast": "120ms",
          "normal": "200ms",
          "slow": "320ms",
          "dramatic": "640ms"
        },
        "easings": {
          "linear": "linear",
          "standard": "cubic-bezier(0.2, 0, 0, 1)",
          "emphasized": "cubic-bezier(0.22, 0.61, 0.36, 1)",
          "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
        },
        "shapes": {
          "modalEnter": "translateY(12px) scale(0.98)",
          "modalExit": "scale(0.98)",
          "pageEnter": "translateY(10px)",
          "popoverEnter": "scale(0.97)",
          "popoverExit": "scale(0.97)",
          "toastEnter": "translateY(-12px)",
          "toastExit": "translateY(-12px)"
        }
      },
      "iconography": {
        "family": "lucide",
        "strokeWidth": "1.75",
        "defaultSize": "16px"
      },
      "elevation": {
        "cardElevation": "var(--shadow-main)",
        "popoverElevation": "var(--shadow-lg)",
