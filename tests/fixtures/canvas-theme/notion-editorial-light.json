        "buttonHeightLg": "52px",
        "inputHeightSm": "36px",
        "inputHeightMd": "44px",
        "inputHeightLg": "52px",
        "rowHeightCompact": "48px",
        "rowHeightNormal": "56px",
        "rowHeightSpacious": "72px",
        "cardPaddingSm": "24px",
