            "lineHeight": "26px"
          },
          "base": {
            "size": "17px",
            "lineHeight": "30px"
          },
          "lg": {
            "size": "21px",
            "lineHeight": "34px"
          },
          "xl": {
            "size": "26px",
            "lineHeight": "38px"
          },
          "2xl": {
            "size": "32px",
            "lineHeight": "44px"
          },
          "3xl": {
            "size": "42px",
            "lineHeight": "52px"
          },
          "4xl": {
            "size": "56px",
            "lineHeight": "64px"
          },
          "display-1": {
            "size": "72px",
            "lineHeight": "80px"
          },
          "display-2": {
            "size": "96px",
            "lineHeight": "104px"
          }
        },
        "intents": {
          "headingMajor": {
            "slot": "display",
            "size": "3xl",
            "weight": "bold"
          },
          "headingMinor": {
            "slot": "display",
            "size": "xl",
            "weight": "bold"
          },
          "bodyEmphasis": {
            "slot": "body",
            "size": "base",
            "weight": "medium"
          },
          "bodyDefault": {
            "slot": "body",
            "size": "base",
            "weight": "normal"
          },
          "bodyQuiet": {
            "slot": "body",
            "size": "sm",
            "weight": "normal"
          },
          "caption": {
            "slot": "body",
            "size": "xs",
            "weight": "medium"
          },
          "numeric": {
            "slot": "mono",
            "size": "4xl",
            "weight": "bold"
          }
        },
        "fontImport": "https://fonts.googleapis.com/css2?family=Lora:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap",
        "headingWeight": "600",
        "headingTransform": "none",
        "headingTracking": "-0.01em",
        "headingStyle": "normal",
        "headingShadow": "none"
      },
      "motion": {
        "durations": {
          "instant": "0ms",
          "fast": "200ms",
          "normal": "350ms",
          "slow": "500ms",
          "dramatic": "700ms"
        },
        "easings": {
          "linear": "linear",
          "standard": "cubic-bezier(0.0, 0.0, 0.2, 1)",
          "emphasized": "cubic-bezier(0.2, 0.0, 0.0, 1)",
          "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
        },
        "shapes": {
          "modalEnter": "translateY(6px) scale(0.98)",
          "modalExit": "translateY(6px) scale(0.98)",
          "pageEnter": "translateY(4px)",
          "popoverEnter": "scale(0.98)",
          "popoverExit": "scale(0.98)",
          "toastEnter": "translateY(8px)",
          "toastExit": "translateY(8px)"
